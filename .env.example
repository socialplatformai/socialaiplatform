# Social AI Platform — variáveis de ambiente (TEMPLATE)
# ----------------------------------------------------------------------------
# Copie para .env e preencha. O .env é gitignored — nunca comite segredos.
#   cp .env.example .env
# Sem as chaves de IA/Meta o sistema sobe em modo degradado (infra + UI ok,
# geração e publicação indisponíveis). As credenciais são responsabilidade
# do cliente.
# ============================================================================

# --- Deploy ----------------------------------------------------------------
# single = 1 workspace (infra do cliente) | multi = N workspaces (um só deploy)
DEPLOY_MODE=single
# Em produção use Production: sem stack trace, fail-fast de segredos, sem Swagger.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
NODE_ENV=development

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=social
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=social_ai
POSTGRES_PORT=5432

# --- JWT (autenticação) ----------------------------------------------------
# Gere uma chave forte (>= 32 bytes). Ex.: openssl rand -base64 48
# Em Production a API recusa subir se este valor for fraco ou ausente.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-no-minimo-32-bytes
JWT_ISSUER=social-ai-platform

# --- Segredos em repouso (AES-GCM) -----------------------------------------
# Chave que cifra o token do Instagram, as chaves de IA e o segredo do app Meta
# no banco. Gere com: openssl rand -base64 48.
# DEFINA ANTES DO 1º DEPLOY — trocá-la depois invalida todos os segredos já
# cifrados. Em Production a API e o worker exigem este valor.
SECRETS_ENCRYPTION_KEY=

# --- MinIO (storage de mídia; a Graph API exige um JPEG em URL pública) -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# URL pública do MinIO, alcançável pela internet (a Graph API baixa a imagem de
# lá). Obrigatória quando PUBLISHER_MODE=graph; vazia em mock. Ex.:
# https://midia.cliente.com — NÃO use minio:9000/localhost (o worker recusa
# subir em modo graph com host interno).
MINIO_PUBLIC_BASE_URL=

# --- Provedor de IA (texto) ------------------------------------------------
# AI_PROVIDER: gemini | openai. Chave do provedor escolhido.
# Gemini: https://aistudio.google.com/apikey
# OpenAI: https://platform.openai.com/api-keys
AI_PROVIDER=gemini
AI_PROVIDER_KEY=

# --- Provedor de imagem ----------------------------------------------------
# IMAGE_PROVIDER: gemini | openai | flux | stock | imagen(stub). Pode reusar AI_PROVIDER_KEY acima,
# OU usar IMAGE_PROVIDER_KEY (dedicada) — para flux/stock a chave dedicada é o caminho normal.
#   gemini → foto generativa (default; usa AI_PROVIDER_KEY)
#   openai → foto generativa via OpenAI Images (gpt-image-2)
#   flux   → foto generativa de alto padrao via Replicate (Black Forest Labs); IMAGE_PROVIDER_KEY = REPLICATE_API_TOKEN
#   stock  → banco de imagens curado via Pexels (busca tematica);             IMAGE_PROVIDER_KEY = PEXELS_API_KEY
# AI_IMAGE_MODEL sobrescreve o slug default por provider (flux: black-forest-labs/flux-1.1-pro).
IMAGE_PROVIDER=gemini
IMAGE_PROVIDER_KEY=

# --- Agents (microserviço interno) -----------------------------------------
# Segredo compartilhado entre a API e o agents. O agents não tem porta pública;
# este token impede que terceiros disparem o pipeline e gastem o orçamento de IA.
# Gere com: openssl rand -base64 32. Vazio em dev = agents aceita sem auth (com aviso).
AGENTS_INTERNAL_TOKEN=

# Liga o override de prompt por workspace (ADR-0011 / ADR-0013). Opt-in: default
# false. Mesmo ligado, há validação + fallback ao prompt-base versionado (nunca
# quebra o pipeline). Deixe false até precisar.
PROMPT_OVERRIDES_ENABLED=false

# Structured output nativo do Gemini (JSON mode). OFF por padrão: o parse resiliente
# atual dá 0 erros e o v1beta pode rejeitar JSON mode em alguns modelos/contas.
# Ligue só se aparecer parse-error real em produção (decisão D-2 da entrega F5-F7).
GEMINI_STRUCTURED_OUTPUT=false

# --- Meta / Instagram (App Review necessário para publicar de verdade) ------
# Crie um app em https://developers.facebook.com/apps (produto Instagram).
# Use Instagram Login (graph.instagram.com), NÃO Facebook Login.
# Enquanto a Meta não aprovar, PUBLISHER_MODE=mock cumpre o fluxo de ponta a ponta.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5080/api/instagram/callback
PUBLISHER_MODE=mock

# Versão da Graph API usada pelo worker (F6/E1). A Meta versiona ~trimestral e
# expira versões ~2 anos após o release; atualize ao migrar. Default v22.0 =
# comportamento atual. O worker loga aviso no boot se ficar abaixo do piso conhecido.
GRAPH_API_VERSION=v22.0

# --- Portas / origens (host) -----------------------------------------------
# O agents NÃO tem porta publicada — só a API o alcança pela rede interna.
API_PORT=5080
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL é embutida no bundle em BUILD-TIME. Trocá-la exige rebuild
# do web (docker compose build web). Aponte para a URL pública da API do cliente.
NEXT_PUBLIC_API_URL=http://localhost:5080
